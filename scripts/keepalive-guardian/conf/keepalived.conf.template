################################################################################
# Keepalive Guardian - Keepalived Configuration Template
#
# This file is processed automatically by install.sh.
# If editing manually, replace {{variable}} placeholders with actual values.
#
# Placeholder reference:
#   {{ROUTER_ID}}              - Hostname of this server (router identifier)
#   {{VRRP_STATE}}             - MASTER (Active) or BACKUP (Standby)
#   {{HB_INTERFACE}}           - Heartbeat interface for VRRP signaling (dedicated link or same as service interface)
#   {{HB_CURRENT_IP}}          - IP address of the Heartbeat interface on this server
#   {{PEER_HB_IP}}             - Peer server's Heartbeat interface IP (for unicast_peer)
#   {{SERVICE_INTERFACE}}      - Service interface to bind VIP (e.g. ens18)
#   {{VRRP_ROUTER_ID}}         - VRRP group ID, must be unique on the same L2 network (1-255)
#   {{VRRP_PRIORITY}}          - Priority (Active=100, Standby=90)
#   {{VRRP_VIRTUAL_IP}}        - Virtual IP address (VIP)
#   {{AUTH_PASSWORD}}          - VRRP authentication password (must match on both servers)
#   {{HEALTH_CHECK_INTERVAL}}  - Health check interval in seconds
#   {{HEALTH_CHECK_FALL}}      - Consecutive failure count to trigger failover
#                                Failover detection time = INTERVAL x FALL (seconds)
################################################################################

global_defs {
    router_id {{ROUTER_ID}}
    vrrp_skip_check_adv_addr
}

vrrp_script chk_service {
    script "/usr/local/bin/service_health_check.sh"
    interval {{HEALTH_CHECK_INTERVAL}}
    weight -20
    fall {{HEALTH_CHECK_FALL}}
    rise 1
}

vrrp_instance VI_1 {
    state {{VRRP_STATE}}
    interface {{HB_INTERFACE}}
    virtual_router_id {{VRRP_ROUTER_ID}}
    priority {{VRRP_PRIORITY}}
    advert_int 1

    # Use unicast instead of multicast (supports L2-isolated and Docker mixed environments)
    unicast_src_ip {{HB_CURRENT_IP}}
    unicast_peer {
        {{PEER_HB_IP}}
    }

    authentication {
        auth_type PASS
        auth_pass {{AUTH_PASSWORD}}
    }

    virtual_ipaddress {
        {{VRRP_VIRTUAL_IP}} dev {{SERVICE_INTERFACE}}
    }

    track_script {
        chk_service
    }

    # Failback stabilization check: runs on MASTER promotion
    notify_master "/usr/local/bin/service_recovery_check.sh"
}
